{
  "expo": {
    "name": "CapWords",
    "slug": "capwords",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#7C6BFF"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.capwords.app",
      "infoPlist": {
        "NSCameraUsageDescription": "CapWords needs camera access to take photos of objects for word learning.",
        "NSMicrophoneUsageDescription": "CapWords needs microphone access to record your pronunciation."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#7C6BFF"
      },
      "package": "com.capwords.app",
      "permissions": ["CAMERA", "RECORD_AUDIO"]
    },
    "plugins": [
      "expo-camera",
      "expo-av",
      "./plugins/withFmtConstevalFix"
    ]
  }
}
