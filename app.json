{
  "expo": {
    "name": "CapWords",
    "slug": "capwords",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3E9D2"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.capwordsxxx.app",
      "infoPlist": {
        "NSCameraUsageDescription": "CapWords needs camera access to take photos of objects for word learning.",
        "NSMicrophoneUsageDescription": "CapWords needs microphone access to record your pronunciation.",
        "NSLocationWhenInUseUsageDescription": "CapWords uses your location to remember where you learned each word."
      },
      "appleTeamId": "A59BMF9Y7J"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3E9D2"
      },
      "package": "com.capwords.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-camera",
      "expo-audio",
      "./plugins/withFmtConstevalFix"
    ],
    "scheme": "capwords"
  }
}
